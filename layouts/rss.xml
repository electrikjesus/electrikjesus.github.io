{{- $pages := where site.RegularPages "Section" "in" (slice "posts" "blog") -}}
{{- if not .IsHome }}{{ $pages = .RegularPages }}{{ end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = first $limit $pages }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ .Title }} · {{ site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with $pages }}<lastBuildDate>{{ (index . 0).Lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}{{ end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      {{ range .Params.tags }}<category>{{ . }}</category>{{ end }}
      {{ with index (.Params.images | default slice) 0 }}<media:content url="{{ strings.TrimPrefix "/" . | absURL }}" medium="image" />{{ end }}
      {{ if eq .Section "blog" }}{{ with partial "article-cover.html" . }}<media:content url="{{ (.Resize "1200x webp").Permalink }}" medium="image" />{{ end }}{{ end }}
      <description>{{ replace .Content `poster="/` (printf `poster="%s` ("" | absURL)) | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
