{{- $out := slice -}}
{{- range where site.RegularPages "Section" "posts" -}}
  {{- $out = $out | append (dict
      "t" .Title
      "u" .Permalink
      "d" (.Date.Format "Jan 2, 2006")
      "s" (.Params.summary | default "")
      "g" (.Params.tags | default slice)
      "k" (.Params.kinds | default slice)
      "i" (cond (gt (len (.Params.images | default slice)) 0) (strings.TrimPrefix "/" (index .Params.images 0) | absURL) "")
      "x" (.Plain | truncate 3000 "")
  ) -}}
{{- end -}}
{{- $out | jsonify -}}
